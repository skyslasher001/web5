{
  "name": "universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm build && node scripts/dev.mjs --prod",
    "build": "pnpm --filter @universe/design-tokens build && pnpm --filter @universe/ui build && pnpm --filter @universe/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm test:py && pnpm test:js",
    "test:py": "uv run pytest",
    "test:js": "vitest run",
    "test:e2e": "playwright test",
    "gen:types": "node scripts/gen-types.mjs",
    "tokens": "node packages/design-tokens/build.mjs",
    "check": "pnpm lint && pnpm typecheck && uv run ruff check && uv run ruff format --check && uv run pyright && pnpm test",
    "bench:universe": "node scripts/universe_bench.mjs",
    "handoff": "uv run python scripts/export_handoff.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
