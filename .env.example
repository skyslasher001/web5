# Copy to .env (never commit .env). Every variable is optional; defaults are shown.
# The dev script (pnpm dev) reads these; secrets never go here (use Windows Credential Manager).

# Where your vault lives (your data). Dev default: ./.dev/vault inside the repo.
# UNIVERSE_VAULT_DIR=D:\UniverseVault

# App runtime data: logs, supervisor state. Dev default: ./.dev/data.
# UNIVERSE_DATA_DIR=

# Core API port on 127.0.0.1.
# UNIVERSE_CORE_PORT=47821

# Ollama endpoint (loopback only) and whether the supervisor may start `ollama serve` itself.
# UNIVERSE_OLLAMA_URL=http://127.0.0.1:11434
# UNIVERSE_MANAGE_OLLAMA=1

# Force a specific chat model instead of the automatic pick (must be installed in Ollama).
# UNIVERSE_MODEL_FAST=gemma4:e4b

# Seconds Core must stay healthy before its commit becomes last-known-good.
# UNIVERSE_LKG_STABLE_S=60

# Seconds Core may take to become healthy before a boot counts as failed.
# UNIVERSE_BOOT_TIMEOUT_S=30
