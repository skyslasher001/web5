@@ -0,0 +1,47 @@
+import { describe, expect, it, vi } from 'vitest';
+import { KillSwitchControl, parseKillSwitchFile } from './killswitch';
+
+function control(overrides: Partial<ConstructorParameters<typeof KillSwitchControl>[0]> = {}) {
+  const calls: string[] = [];
+  const ks = new KillSwitchControl({
+    initial: false,
+    setOnSupervisor: vi.fn(async (engaged: boolean) => {
+      calls.push(`supervisor:${engaged}`);
+      return { engaged, core_acked: true };
+    }),
+    stopCapture: () => calls.push('capture-stopped'),
+    confirmRelease: async () => true,
+    onChange: (engaged) => calls.push(`changed:${engaged}`),
+    log: () => {},
+    ...overrides,
+  });
+  return { ks, calls };
+}
+
+describe('kill switch', () => {
+  it('stops capture locally before anything else, and shows engaged at once', async () => {
+    const { ks, calls } = control();
+    await ks.set(true, 'hotkey');
+    expect(calls).toEqual(['capture-stopped', 'changed:true', 'supervisor:true']);
+    expect(ks.engaged).toBe(true);
+  });
+
+  it('releases only after the native dialog is confirmed', async () => {
+    const declined = control({ initial: true, confirmRelease: async () => false });
+    await declined.ks.set(false, 'hud');
+    expect(declined.ks.engaged).toBe(true);
+    expect(declined.calls).toEqual([]);
+
+    const confirmed = control({ initial: true });
+    await confirmed.ks.set(false, 'tray');
+    expect(confirmed.ks.engaged).toBe(false);
+    expect(confirmed.calls).toEqual(['supervisor:false', 'changed:false']);
+  });
+
+  it('reads the state file fail-safe', () => {
+    expect(parseKillSwitchFile(null)).toBe(false); // no file: never engaged
+    expect(parseKillSwitchFile('{"engaged":true}')).toBe(true);
+    expect(parseKillSwitchFile('{"engaged":false}')).toBe(false);
+    expect(parseKillSwitchFile('{garbage')).toBe(true); // unreadable: engaged
+  });
+});
diff --git a/apps/desktop/src/main/protected/killswitch.ts b/apps/desktop/src/main/protected/killswitch.ts
new file mode 100644
index 0000000..1acc54d
--- /dev/null
+++ b/apps/desktop/src/main/protected/killswitch.ts
@@ -0,0 +1,73 @@
+// The global kill switch (SPEC §15, ARCHITECTURE.md §1.4). PROTECTED CORE.
+// Engaging is instant and needs no confirmation: capture stops here first, then the supervisor stops the
+// agents and network jobs (restarting Core if it doesn't answer). Releasing needs a native dialog, which
+// no renderer code (and nothing in Core) can click.
+import { readFileSync } from 'node:fs';
+
+export const KILL_SWITCH_HOTKEY = 'CommandOrControl+Alt+Shift+K';
+
+export interface KillSwitchResult {
+  engaged: boolean;
+  core_acked: boolean;
+}
+
+/** The state file the supervisor writes; unreadable means engaged (fail safe), missing means off. */
+export function parseKillSwitchFile(text: string | null): boolean {
+  if (text === null) return false;
+  try {
+    const value = JSON.parse(text) as { engaged?: unknown };
+    return value.engaged === true;
+  } catch {
+    return true;
+  }
+}
+
+export function readKillSwitchFile(path: string): boolean {
+  let text: string | null = null;
+  try {
+    text = readFileSync(path, 'utf8');
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code !== 'ENOENT') return true;
+  }
+  return parseKillSwitchFile(text);
+}
+
+export class KillSwitchControl {
+  engaged: boolean;
+
+  constructor(
+    private readonly opts: {
+      initial: boolean;
+      /** POST /killswitch on the supervisor. */
+      setOnSupervisor: (engaged: boolean) => Promise<KillSwitchResult>;
+      /** Stop mic, screen and camera capture locally, before anything else (none exists before Phase 7). */
+      stopCapture: () => void;
+      /** A native yes/no dialog; resolves true only if you confirm. */
+      confirmRelease: () => Promise<boolean>;
+      onChange: (engaged: boolean) => void;
+      log: (event: string, fields: Record<string, unknown>) => void;
+    },
+  ) {
+    this.engaged = opts.initial;
+  }
+
+  async set(engaged: boolean, via: string): Promise<KillSwitchResult> {
+    if (engaged) {
+      this.opts.stopCapture();
+    } else if (!(await this.opts.confirmRelease())) {
+      return { engaged: this.engaged, core_acked: true };
+    }
+    // Reflect an engage at once, even if the supervisor is slow: the indicator must never lag behind.
+    if (engaged) this.update(true);
+    const result = await this.opts.setOnSupervisor(engaged);
+    this.update(result.engaged);
+    this.opts.log('killswitch', { engaged: result.engaged, via, core_acked: result.core_acked });
+    return result;
+  }
+
+  private update(engaged: boolean): void {
+    if (engaged === this.engaged) return;
+    this.engaged = engaged;
+    this.opts.onChange(engaged);
+  }
+}
