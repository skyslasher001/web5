diff --git a/services/core/src/universe_core/protected/consent_api.py b/services/core/src/universe_core/protected/consent_api.py
new file mode 100644
index 0000000..2972e4e
--- /dev/null
+++ b/services/core/src/universe_core/protected/consent_api.py
@@ -0,0 +1,49 @@
+"""Consent mirror (ARCHITECTURE §5: `GET /consent`). PROTECTED CORE.
+
+Electron main owns consent: it alone decides whether Chromium may open the microphone. It reports every change
+here so the audit log and the timeline record it (`consent.changed`) and the HUD can show it. Core never grants
+capture from this record; a wrong report can't open a mic, only mislabel the log.
+"""
+
+from datetime import UTC, datetime
+from typing import Literal
+
+from fastapi import APIRouter, Request
+from pydantic import BaseModel, Field
+
+from universe_common.schema import ApiModel
+
+router = APIRouter(prefix="/api/v1")
+
+
+class ConsentRecord(ApiModel):
+    mic: bool
+    via: str | None
+    changed_at: str | None
+
+
+class ConsentReport(BaseModel):
+    kind: Literal["mic"] = "mic"
+    on: bool
+    via: Literal["hud", "voice", "tray", "killswitch", "window"] = Field(description="Where the change came from")
+
+
+@router.get("/consent", response_model=ConsentRecord)
+async def consent(request: Request) -> ConsentRecord:
+    return getattr(request.app.state, "consent", None) or ConsentRecord(mic=False, via=None, changed_at=None)
+
+
+@router.post("/consent", response_model=ConsentRecord)
+async def report_consent(request: Request, body: ConsentReport) -> ConsentRecord:
+    ctx = request.app.state.ctx
+    record = ConsentRecord(mic=body.on, via=body.via, changed_at=datetime.now(UTC).isoformat())
+    request.app.state.consent = record
+    ctx.audit.append(
+        actor="user",
+        action="consent.changed",
+        target_type="consent",
+        target_id=body.kind,
+        details={"on": body.on, "via": body.via},
+    )
+    ctx.bus.publish("consent.changed", {"kind": body.kind, "on": body.on, "via": body.via}, actor="user")
+    return record
diff --git a/tests/protected/test_consent_api.py b/tests/protected/test_consent_api.py
new file mode 100644
index 0000000..73ae89c
--- /dev/null
+++ b/tests/protected/test_consent_api.py
@@ -0,0 +1,29 @@
+"""The consent mirror (Phase 7 protected core): off until main reports otherwise, and every change audited."""
+
+from fastapi.testclient import TestClient
+
+from tests.conftest import AUTH
+
+
+def test_consent_is_off_until_main_reports_it(client: TestClient) -> None:
+    response = client.get("/api/v1/consent", headers=AUTH)
+    assert response.status_code == 200
+    assert response.json() == {"mic": False, "via": None, "changed_at": None}
+
+
+def test_every_change_is_audited_and_published(client: TestClient) -> None:
+    on = client.post("/api/v1/consent", json={"on": True, "via": "hud"}, headers=AUTH)
+    assert on.status_code == 200 and on.json()["mic"] is True
+    off = client.post("/api/v1/consent", json={"on": False, "via": "killswitch"}, headers=AUTH)
+    assert off.json()["mic"] is False
+    assert client.get("/api/v1/consent", headers=AUTH).json()["via"] == "killswitch"
+    audit = client.get("/api/v1/audit", params={"action": "consent.changed"}, headers=AUTH).json()
+    assert [(a["details"]["on"], a["details"]["via"]) for a in audit][:2] == [(False, "killswitch"), (True, "hud")]
+    events = client.get("/api/v1/events", params={"type": "consent.changed"}, headers=AUTH).json()["events"]
+    assert [e["payload"]["on"] for e in events] == [True, False]
+
+
+def test_reports_need_the_session_token_and_a_known_source(client: TestClient) -> None:
+    assert client.post("/api/v1/consent", json={"on": True, "via": "hud"}).status_code == 401
+    bad = client.post("/api/v1/consent", json={"on": True, "via": "a webpage"}, headers=AUTH)
+    assert bad.status_code == 422
