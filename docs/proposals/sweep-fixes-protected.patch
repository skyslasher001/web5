+def test_a_running_check_stops_when_asked(tmp_path: Path) -> None:
+    """Sweep 2026-10-22: the kill switch didn't stop a running verification (subprocess.run ran to its 15-minute
+    timeout). A check stops, with its whole process tree, as soon as `stop` says so; the next steps don't run."""
+    import os
+    import sys
+    import threading
+    import time
+
+    from universe_core import forge_verify
+
+    pid_file = tmp_path / "grandchild.pid"
+    script = (
+        "import subprocess, sys, time\n"
+        f"p = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(120)'])\n"
+        f"open({str(pid_file)!r}, 'w').write(str(p.pid))\n"
+        "time.sleep(120)\n"
+    )
+    flag = threading.Event()
+    threading.Timer(1.0, flag.set).start()
+    started = time.monotonic()
+    result = forge_verify.run("slow", [sys.executable, "-c", script], tmp_path, dict(os.environ), 600, stop=flag.is_set)
+    assert time.monotonic() - started < 15
+    assert not result.ok and "stopped" in result.output
+    grandchild = int(pid_file.read_text())
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        try:
+            os.kill(grandchild, 0)
+        except ProcessLookupError:
+            break
+        time.sleep(0.1)
+    else:
+        pytest.fail("the check's child process outlived the stop")
+    # With stop already set, the verifier runs nothing more.
+    verifier = Verifier(tmp_path, stop=lambda: True)
+    (tmp_path / "head").mkdir()
+    (tmp_path / "head" / "test_x.py").write_text("def test_x() -> None:\n    assert True\n", encoding="utf-8")
+    (tmp_path / "base").mkdir()
+    repro = verifier.repro(tmp_path / "base", tmp_path / "head", "test_x.py")
+    assert repro["fails_on_base"] is False and repro["passes_on_head"] is False and "stopped" in repro["error"]
+    checks = verifier.checks(tmp_path / "head", ["test_x.py"])
+    assert [c.name for c in checks] == ["stopped"] and not checks[0].ok
