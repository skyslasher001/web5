+def test_an_automatic_rollback_on_a_dirty_checkout_stops_the_watch(repo: Path, tmp_path: Path) -> None:
+    # Sweep 2026-10-22: the dirty-checkout refusal came before the conflict handling, so the release stayed
+    # "watching" and the supervisor's watch retried the rollback every 0.2 s tick, for ever.
+    releases = Releases(repo, tmp_path / "releases.json")
+    release = releases.apply(**forge_branch(repo))
+    (repo / "README.md").write_text("the owner's unsaved work\n", encoding="utf-8")
+    sh(repo, "add", "README.md")
+    with pytest.raises(ReleaseError, match="uncommitted"):
+        releases.rollback(release["tag"], "automatic: Core crashed 2 times after the change", automatic=True)
+    saved = Releases(repo, tmp_path / "releases.json").list()[0]
+    assert saved["status"] == "rollback_failed" and "uncommitted" in saved["rollback_reason"]
+    assert releases.watching() is None
+    assert (repo / "README.md").read_text() == "the owner's unsaved work\n"  # nothing of yours is touched
+    # A rollback you ask for on a dirty checkout changes nothing either; commit or stash, then ask again.
+    other = Releases(repo, tmp_path / "other.json")
+    other.data["releases"].append({**release, "status": "watching"})
+    with pytest.raises(ReleaseError, match="uncommitted"):
