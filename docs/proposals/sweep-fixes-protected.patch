+/**
+ * For watching the state file: true only for a clean read that says engaged, null when it can't be read. (A
+ * read during the supervisor's atomic replace can fail on Windows; that must not engage by itself here. At
+ * launch, readKillSwitchFile still treats an unreadable file as engaged.)
+ */
+export function peekKillSwitchFile(path: string): boolean | null {
+  let text: string;
+  try {
+    text = readFileSync(path, 'utf8');
+  } catch (err) {
+    return (err as NodeJS.ErrnoException).code === 'ENOENT' ? false : null;
+  }
+  try {
+    return (JSON.parse(text) as { engaged?: unknown }).engaged === true;
+  } catch {
+    return null;
+  }
+}
+
+/** Poll the state file and hand each reading to `onRead` (KillSwitchControl.observe). Returns a stop function. */
+export function watchKillSwitchFile(
+  path: string,
+  onRead: (engaged: boolean | null) => void,
+  intervalMs = 1000,
+): () => void {
+  const timer = setInterval(() => onRead(peekKillSwitchFile(path)), intervalMs);
+  timer.unref?.();
+  return () => clearInterval(timer);
+}
